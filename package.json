{
  "name": "timmbr-ds",
  "version": "1.1.0",
  "private": true,
  "description": "Timmbr Enterprise Design System",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "turbo run dev",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"apps/*/src/**/*.{ts,tsx}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "storybook": "pnpm --filter @timmbr/storybook dev",
    "build-storybook": "pnpm --filter @timmbr/storybook build",
    "build:storybook:ci": "turbo run build --filter=@timmbr/storybook...",
    "pack:dry-run": "pnpm --filter \"./packages/*\" --filter \"!@timmbr/tsconfig\" --filter \"!@timmbr/eslint-config\" pack --dry-run",
    "yalc:push": "node scripts/yalc-push.mjs",
    "release": "node scripts/publish.mjs",
    "release:all": "node scripts/publish.mjs --all",
    "changeset": "changeset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "turbo": "^2.10.12",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "motion": "^12.43.0"
  }
}
