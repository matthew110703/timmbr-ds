{
  "name": "timmbr-ds",
  "version": "1.0.0-beta",
  "private": true,
  "description": "Timmbr Enterprise Design System",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "storybook": "pnpm --filter @timmbr/storybook dev",
    "build-storybook": "pnpm --filter @timmbr/storybook build",
    "build:storybook:ci": "turbo run build --filter=@timmbr/storybook...",
    "pack:dry-run": "pnpm --filter \"./packages/*\" --filter \"!@timmbr/tsconfig\" --filter \"!@timmbr/eslint-config\" pack --dry-run",
    "release": "node scripts/publish.mjs",
    "release:all": "node scripts/publish.mjs --all",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "turbo": "^2.10.12",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "motion": "^12.43.0"
  }
}
